{
  "name": "aranmobinn",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "serve": "tsx src/server.ts",
    "docker:build": "docker build -t aranmobinn .",
    "docker:run": "docker run --rm -p 3000:3000 aranmobinn",
    "docker:compose": "docker-compose up"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ethers": "^6.13.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "axios": "^1.7.7",
    "pg": "^8.12.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.1.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/pg": "^8.11.6",
    "@types/bcryptjs": "^2.4.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
